00 ============================================================
00 极其复杂测试程序
00 测试所有语法特性
00 ============================================================

00 ---- 全局变量 ----
ts g_count a0 0
ts g_sum a0 0
ts g_max a0 100

00 ---- 全局数组 ----
tf g_arr a7 16 a8

00 ============================================================
00 函数0：输出字符
00 ============================================================
tt chu 01 c u64 02  08
    zt putc 01 c 02
 09

00 ============================================================
00 函数1：加法
00 ============================================================
tt add 01 a u64 b u64 02  08
    ht a b
    zz
 09

00 ============================================================
00 函数2：阶乘
00 ============================================================
tt fact 01 n u64 02  08
    lr n a5 1  08
        zz 1
     09
    tz t a0 n hz 1
    tz r a0 zt fact 01 t 02
    hh n r
    zz
 09

00 ============================================================
00 函数3：斐波那契
00 ============================================================
tt fib 01 n u64 02  08
    lr n a5 1  08
        zz n
     09
    tz a a0 zt fib 01 n hz 1 02
    tz b a0 zt fib 01 n hz 2 02
    ht a b
    zz
 09

00 ============================================================
00 函数4：数组求和
00 ============================================================
tt sum_arr 01 arr u64 len u64 02  08
    tz i a0 0
    tz s a0 0
    ll  08
        lz i len  08 ls  09
        tz v a0 arr a7 i a8 
        s a0 ht s v
        i a0 ht i 1
     09
    zz s
 09

00 ============================================================
00 函数5：判断质数
00 ============================================================
tt is_prime 01 n u64 02  08
    lr n a5 1  08
        zz 0
     09
    tz i a0 2
    ll  08
        lz i ht i a5 n  08 ls  09
        tz r a0 n hf i
        lr r a1 0  08
            zz 0
         09
        i a0 ht i 1
     09
    zz 1
 09

00 ============================================================
00 函数6：冒泡排序
00 ============================================================
tt bubble_sort 01 arr u64 len u64 02  08
    tz i a0 0
    ll  08
        lz i len hz 1  08 ls  09
        tz j a0 0
        ll  08
            lz j len hz i hz 1  08 ls  09
            tz a a0 arr a7 j a8 
            tz b a0 arr a7 j ht 1 a8 
            lr a > b  08
                arr a7 j a8  a0 b
                arr a7 j ht 1 a8  a0 a
             09
            j a0 ht j 1
         09
        i a0 ht i 1
     09
    zz 0
 09

00 ============================================================
00 函数7：字符串长度
00 ============================================================
tt str_len 01 s 02  08
    tz i a0 0
    ll  08
        tz c a0 fr s ht i
        lr c a1 0  08 ls  09
        i a0 ht i 1
     09
    zz i
 09

00 ============================================================
00 函数8：打印数字
00 ============================================================
tt print_num 01 n u64 02  08
    tz buf a7 32 a8 
    tz i a0 0
    lr n a1 0  08
        zt chu 01 48 02
        zz 0
     09
    lr n < 0  08
        zt chu 01 45 02
        n a0 hz 0 n
     09
    ll  08
        lz n a1 0  08 ls  09
        tz d a0 n hf 10
        n a0 n hl 10
        buf a7 i a8  a0 ht d 48
        i a0 ht i 1
     09
    tz j a0 i hz 1
    ll  08
        lz j < 0  08 ls  09
        zt chu 01 buf a7 j a8  02
        j a0 hz j 1
     09
    zz 0
 09

00 ============================================================
00 主函数
00 ============================================================
tt zhu 01 fname 02  08
    00 初始化数组
    tz i a0 0
    ll  08
        lz i 16  08 ls  09
        g_arr a7 i a8  a0 hf 100 ht i 7
        i a0 ht i 1
     09

    00 计算阶乘
    tz f a0 zt fact 01 10 02
    st dd "fact(10) a0 "
    zt print_num 01 f 02

    00 计算斐波那契
    tz fib10 a0 zt fib 01 10 02
    st dd "fib(10) a0 "
    zt print_num 01 fib10 02

    00 数组求和
    tz s a0 zt sum_arr 01 g_arr a9 16 02
    st dd "sum(arr) a0 "
    zt print_num 01 s 02

    00 判断质数
    tz p a0 zt is_prime 01 97 02
    st dd "is_prime(97) a0 "
    zt print_num 01 p 02

    00 冒泡排序
    zt bubble_sort 01 g_arr a9 16 02
    st dd "after sort: "
    tz j a0 0
    ll  08
        lz j 16  08 ls  09
        tz v a0 g_arr a7 j a8 
        zt print_num 01 v 02
        zt chu 01 32 02
        j a0 ht j 1
     09

    00 字符串测试
    tz str a0 dd "hello world"
    tz len a0 zt str_len 01 str 02
    st dd "str_len(hello world) a0 "
    zt print_num 01 len 02

    st dd "done!"
    zz 0
 09
