00 ══════════════════════════════════════════════════════
00  01 字符串遍历
00 ══════════════════════════════════════════════════════
00
00  字符串就是一片内存，一个字节放一个英文字符，
00  最后放一个 0 表示结束。
00
00  汉字占 3 个字节（UTF-8），所以不能一个字节一个字节地数
00  字数，得看最高位判断。
00
00  本例子只数 ASCII 字符（英文、数字、符号）。
00 ══════════════════════════════════════════════════════

tt numlen 01 s 02 -> u64  08
    tz n = 0
    tz addr = 0
    tz byte = 0

    addr = s
    n = 0
    ll  08
        byte = fh addr
        byte = 01 byte hs 255 02
        lz byte 0  08 ls 09
        n = 01 n ht 1 02
        addr = 01 addr ht 1 02
     09
    zz n
 09

tt zhu 01 02 -> u64  08
    tz s = 0
    s = "Hello Guafang "

    puts 01 s 02
    putc 01 10 02
    puts 01 "长度 " 02
    puti 01 zt numlen 01 s 02 02
    putc 01 10 02

    zz 0
 09
