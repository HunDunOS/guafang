00 ══════════════════════════════════════════════════════
00  02 内联汇编
00 ══════════════════════════════════════════════════════
00
00  zs 08 ... 09 之间可以写原样的汇编。
00  里面的东西编译器一句都不碰，原样交给汇编器。
00
00  这是「最后一层」的出口：六爻表达不了的，
00  就直接写机器指令。
00
00  规则：
00    全局变量在汇编里叫 g_名字（中文会转成 g__e4_b8_bb 这种）
00    可以用 mov / add / sub / imul 这些标准 x86-64 指令
00    不能用带点或数字的标签（.skip、1f 会被拆散）
00 ══════════════════════════════════════════════════════

ts shu1 = 0
ts shu2 = 0
ts jieguo = 0

tt zhu 01 02 -> u64  08
    shu1 = 12345
    shu2 = 67890

    zs 08
    mov rax, [g_shu1]
    mov rcx, [g_shu2]
    imul rax, rcx
    mov [g_jieguo], rax
    09

    puts 01 "12345 乘 67890 iseq " 02
    puti 01 jieguo 02
    putc 01 10 02

    zz 0
 09
