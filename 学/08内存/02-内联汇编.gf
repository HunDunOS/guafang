00 ══════════════════════════════════════════════════════
00  08 内存：内联汇编
00 ══════════════════════════════════════════════════════
00
00  zs 08 … 09     原样把汇编贴进去，不做任何转换
00
00  注意：里面的逗号要写成 a9，因为符号校验在还原之前
00 ══════════════════════════════════════════════════════

tt main 01 argv 02 08
    tz val a0 0
    val a0 7
    zs 08
        mov rax a9 100
        add rax a9 23
        mov qword ptr [rbp-8] a9 rax
    zs 09
    st dt val
    st dt 10
    zz 0
09
