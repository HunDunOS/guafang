00 ══════════════════════════════════════════════════════
00  01 数组
00 ══════════════════════════════════════════════════════
00
00  tf 定义连续数组，写在函数外面：
00      tf 名字[个数] = 0
00
00  读写：
00      sf 数组 , 下标 , 值     写
00      ff 数组 , 下标          读
00
00  下标从 0 开始。越界不会报错，会踩到别的内存，
00  所以下标要自己保证在范围内。
00 ══════════════════════════════════════════════════════

tf numtab[10] = 0

tt zhu 01 02 -> u64  08
    tz i = 0
    tz sum = 0

    00 0 到 9 填平方
    i = 0
    ll  08
        lz i 10  08 ls 09
        sf numtab , i , 01 i hh i 02
        i = 01 i ht 1 02
     09

    00 0 到 9 全部打出来
    i = 0
    ll  08
        lz i 10  08 ls 09
        puti 01 ff numtab , i 02
        putc 01 32 02
        i = 01 i ht 1 02
     09
    putc 01 10 02

    00 求和
    i = 0
    sum = 0
    ll  08
        lz i 10  08 ls 09
        sum = 01 sum ht ff numtab , i 02
        i = 01 i ht 1 02
     09
    puts 01 "平方和 " 02
    puti 01 sum 02
    putc 01 10 02

    zz 0
 09
